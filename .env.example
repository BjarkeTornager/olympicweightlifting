DATABASE_URL=postgresql://lift:CHANGE_ME@localhost:54329/lift_journal
DATABASE_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://127.0.0.1:3000
# Required in production. Only this Google account can manage invitations.
OWNER_EMAIL=you@example.com
# Development only, when OWNER_EMAIL is unset. Ignored in production.
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only; ignored in production. Never use real passwords here.
LOCAL_PASSWORD_AUTH=false
# Optional: DDL-capable connection used only by the release migration command.
MIGRATION_DATABASE_URL=
# Optional: disposable database for integration tests; never production.
TEST_DATABASE_URL=

# Optional training assistant. Configure ONLY after choosing the provider/data arrangement.
# Local: http://127.0.0.1:11434/api (reachable from the app host, not a visitor's laptop).
# Cloud: https://ollama.com/api, with a server-only key.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Hosted assistant (recommended). Keys stay on the server.
AGENT_PROVIDER=openrouter
AGENT_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=
