DATABASE_URL=postgresql://lift:CHANGE_ME@localhost:54329/lift_journal
DATABASE_PASSWORD=CHANGE_ME
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://127.0.0.1:3000
# Required in production. Only this Google account can manage invitations.
OWNER_EMAIL=you@example.com
# Development only, when OWNER_EMAIL is unset. Ignored in production.
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Server-only. Maps JavaScript, Geocoding, Places and Directions. Never NEXT_PUBLIC.
GOOGLE_MAPS_API_KEY=
# Server-only. Exa web search for Coach's search_web tool. Without it the tool
# is not offered at all. Only the search query leaves the server, never journal
# data. Never NEXT_PUBLIC.
EXA_API_KEY=
# Optional prices for the AI cost ledger, in US dollars, for calls the provider
# doesn't price one by one (lib/ai-usage.ts). Empty keeps the built-in price.
AI_PRICE_JEV_REQUEST=
AI_PRICE_EXA_SEARCH=
AI_PRICE_VOICE_GEMINI_MINUTE=
AI_PRICE_VOICE_ELEVENLABS_MINUTE=
# Per-account usage limits on Coach and voice (lib/usage-limits.ts). "log", the
# default, only logs and counts what would have been refused; "enforce" refuses.
# Manual logging, the outbox and Health sync are never limited.
LIMITS_MODE=log
# Local development only; ignored in production. Never use real passwords here.
LOCAL_PASSWORD_AUTH=false
# Optional: DDL-capable connection used only by the release migration command.
MIGRATION_DATABASE_URL=
# Optional: disposable database for integration tests; never production.
TEST_DATABASE_URL=

# Optional training assistant. Configure ONLY after choosing the provider/data arrangement.
# Local: http://127.0.0.1:11434/api (reachable from the app host, not a visitor's laptop).
# Cloud: https://ollama.com/api, with a server-only key.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Hosted assistant (recommended). Keys stay on the server.
AGENT_PROVIDER=openrouter
AGENT_MODEL=openai/gpt-5.6-luna
OPENROUTER_API_KEY=
# Optional AI pictures of dishes on Coach's recipe cards, through OpenRouter
# (the key above) with zero data retention; for example
# google/gemini-3.1-flash-lite-image. Empty switches pictures off. Only the dish
# name and up to five ingredient names are sent.
COACH_PICTURE_MODEL=
# Pictures per athlete a day and per 30 days, and a daily USD ceiling across
# everyone. Defaults: 5, 30 and 2.
COACH_PICTURES_PER_DAY=
COACH_PICTURES_PER_MONTH=
COACH_PICTURES_DAILY_USD=

# Optional private SAM 3.1 GPU worker. Server-only; no NEXT_PUBLIC prefix.
# Set endpoint/token and one verified account after the GPU smoke test succeeds.
# Empty pilot email disables SAM. HTTPS endpoint; no query string.
VIDEO_SAM3_URL=
VIDEO_SAM3_TOKEN=
VIDEO_SAM3_PILOT_EMAIL=
# Optional authenticated SAM 3D Body endpoint; uses the same verified-account pilot and service token.
VIDEO_BODY_URL=
# Optional daily Web Push reminders. Generate a pair once with:
# node -e 'console.log(JSON.stringify(require("web-push").generateVAPIDKeys()))'
# Keep the private key only in server configuration. No Apple account required.
DAILY_REMINDERS_WORKER=0
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Optional safety nets for work a restart cuts off, run every minute: tags
# again images left pending and marks Coach turns left running as failed.
# On in the Docker image. Tagging again uses the model provider above.
SWEEPER_WORKER=0
# Restate (docs/restate-setup.md). 1 starts the endpoint a Restate server calls,
# on its own port over HTTP/2; so far it serves only a Ping service. Locally:
#   docker compose --env-file .env.local --profile restate up -d restate
#   node --import tsx scripts/restate-register.ts --ping
RESTATE_ENDPOINT=0
# Defaults: 9080, and 127.0.0.1 locally or :: in production.
RESTATE_ENDPOINT_PORT=
RESTATE_ENDPOINT_HOST=
# The SDK's log level: TRACE, DEBUG, INFO, WARN or ERROR. Unset is INFO
# locally and WARN in production, since INFO logs every call's target.
RESTATE_LOGGING=
# Restate's public request-signing keys (publickeyv1_...), comma-separated.
# Required in production; make a pair with
#   node --import tsx scripts/restate-identity-key.ts
RESTATE_IDENTITY_KEYS=
# Restate's admin API and ingress, used by scripts/restate-register.ts.
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_INGRESS_URL=http://localhost:8080
# When another save lands while Coach logs something that doesn't touch the
# same entries, Coach saves its change on the newer journal. 0 reports the
# conflict instead, so the app asks again on the latest records.
COACH_SAVE_RETRY=1
# 1 writes each Coach reply's progress to Postgres as it streams, so an app
# whose connection drops can read on from the last event it got with
# GET /api/agent/run?turnId=<id>&after=<last SSE id>. A closed connection
# stops a reply as it does today: on the website, but not in the iPhone's
# background mode. The sweeper removes the progress ten minutes after a reply
# ends. Off by default: replies stream as before.
COACH_TURN_EVENTS=0
# Optional spoken check-in (Gemini Live API). Server-only; the phone receives a
# single-use 10-minute token, never this key. Without it the button is hidden.
# Speech and transcripts go to Google; saves still go through Coach with Undo.
GEMINI_API_KEY=
# Defaults to gemini-3.8-live-extended-thinking; gemini-3.8-live answers faster.
VOICE_MODEL=
# Optional diagnostic traces to a self-hosted MLflow (docs/tracing.md):
# timings, models, tokens and cost, never content. Off unless
# TRACING=metadata; in production switch it on only once the privacy page
# describes it (docs/tracing-setup.md). With TRACING off but MLflow set,
# traces already sent still expire and are deleted with their account.
TRACING=off
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_ID=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
# At least 32 characters in production (openssl rand -hex 32). Never rotate
# it: older traces could then only expire, not be deleted with an account.
TRACE_USER_SECRET=
TRACE_SAMPLE_RATE=1
TRACE_RETENTION_DAYS=30
# Keeps Next.js's own fetch spans, whose URLs can carry keys and place
# names, off if a global tracer is ever added.
NEXT_OTEL_FETCH_DISABLED=1
