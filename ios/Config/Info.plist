<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys without an INFOPLIST_KEY_ build setting. Xcode merges this with the generated Info.plist. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- A spoken check-in keeps going while the screen is locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The launch screen is the ink cover, as the privacy cover and sign-in. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
