<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys without an INFOPLIST_KEY_ build setting. Xcode merges this with the generated Info.plist. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- A spoken check-in keeps going while the screen is locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Debug builds may talk to a local `npm run dev` server over HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
