{
  "name": "lift-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check js/data.js && node --check js/storage.js && node --check js/app.js && node --check js/updates.js && node --check js/refresh.js && node --check sw.js && node scripts/check.mjs && node --test scripts/progression.test.mjs",
    "serve": "python3 -m http.server 4173",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "verify:videos": "node scripts/verify-videos.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build --webpack && node scripts/build-offline.mjs && node scripts/build-migrate.mjs",
    "start": "node scripts/serve-production.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "check:production": "npm run typecheck && npm run lint && npm run check && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "idb": "8.0.3",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "railway": "3.11.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
